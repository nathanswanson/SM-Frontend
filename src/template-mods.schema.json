{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Template Modifications Schema",
    "type": "array",
    "items": {
        "oneOf": [
            {
                "allOf": [
                    {
                        "$ref": "#/$defs/baseControl"
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "Toggle"
                            },
                            "default": {
                                "type": "boolean"
                            }
                        }
                    }
                ]
            },
            {
                "allOf": [
                    {
                        "$ref": "#/$defs/baseControl"
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "Text"
                            },
                            "default": {
                                "type": "string"
                            },
                            "placeholder": {
                                "type": "string"
                            }
                        }
                    }
                ]
            },
            {
                "allOf": [
                    {
                        "$ref": "#/$defs/baseControl"
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "Number"
                            },
                            "default": {
                                "type": "number"
                            },
                            "min": {
                                "type": "number"
                            },
                            "max": {
                                "type": "number"
                            }
                        }
                    }
                ]
            },
            {
                "allOf": [
                    {
                        "$ref": "#/$defs/baseControl"
                    },
                    {
                        "properties": {
                            "type": {
                                "const": "Option"
                            },
                            "options": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "default": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "options"
                        ]
                    }
                ]
            }
        ]
    },
    "$defs": {
        "baseControl": {
            "type": "object",
            "properties": {
                "key": {
                    "type": "string",
                    "description": "Docker ENV key to modify."
                },
                "label": {
                    "type": "string",
                    "description": "User-friendly label for the form control."
                },
                "description": {
                    "type": "string",
                    "description": "Help text displayed to the user.",
                    "default": ""
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "Toggle",
                        "Text",
                        "Number",
                        "Option"
                    ]
                },
                "required": {
                    "type": "boolean",
                    "description": "Whether this field is required.",
                    "default": false
                },
                "dependsOn": {
                    "type": "array",
                    "description": "List of keys that this field depends on.",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                },
                "dependentRequired": {}
            },
            "required": [
                "key",
                "label",
                "type"
            ]
        }
    }
}